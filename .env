# Salin file ini menjadi .env dan ganti USERNAME/nilai lain sesuai
# environment Anda, lalu load dengan:
#   export $(grep -v '^#' .env | xargs)
# (jalankan tiap sesi terminal baru, atau taruh di ~/.bashrc)

# --- Dipakai di Tahap 1 (OCR) ---
OLLAMA_HOST=http://localhost:11434
OCR_MODEL_NAME=glm-ocr
# 8192 terbukti aman untuk GPU 4GB VRAM (mis. RTX 3050). Naikkan jika
# GPU Anda punya VRAM lebih besar dan ingin dokumen lebih panjang/dpi
# tinggi; turunkan jika masih terjadi "CUDA error: out of memory".
OCR_NUM_CTX=8192

# --- Dipakai di Tahap 2 (ekstraksi field) ---
EXTRACTION_MODEL_NAME=qwen2.5:7b
EXTRACTION_NUM_CTX=8192
# Hanya baca N halaman pertama saat ekstraksi (mengecualikan lampiran).
# Set ke 0 untuk membaca semua halaman lagi.
EXTRACTION_MAX_PAGES=2

# --- Path database lokal ---
GLM_OCR_DB_PATH=/home/jiebon15/.local/share/glm-ocr-app/app.db

# --- Disiapkan untuk Tahap 4 (belum dipakai) ---
GOOGLE_APPLICATION_CREDENTIALS=/home/jiebon15/.config/glm-ocr-app/credentials.json
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=


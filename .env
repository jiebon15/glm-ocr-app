# Salin file ini menjadi .env dan ganti USERNAME/nilai lain sesuai
# environment Anda, lalu load dengan:
#   export $(grep -v '^#' .env | xargs)
# (jalankan tiap sesi terminal baru, atau taruh di ~/.bashrc)

# --- Dipakai di Tahap 1 (OCR) ---
OLLAMA_HOST=http://localhost:11434
OCR_MODEL_NAME=glm-ocr
# 8192 terbukti aman untuk GPU 4GB VRAM (mis. RTX 3050).
OCR_NUM_CTX=8192

# --- Dipakai di Tahap 2 (ekstraksi field, 2 panggilan model) ---
EXTRACTION_MODEL_NAME=qwen2.5:7b
# Panggilan #1: field administratif (nomor surat, tanggal, dst) dari
# halaman 1-2 saja -> teks pendek, context kecil cukup.
EXTRACTION_NUM_CTX=8192
# Panggilan #2: field lain (petugas, UPI, no_reg, dst) dari SELURUH
# dokumen termasuk lampiran -> teks lebih panjang, butuh context lebih
# besar. Turunkan/naikkan sesuai VRAM & panjang dokumen Anda.
EXTRACTION_FULL_NUM_CTX=16384
# Jumlah halaman pertama yang dipakai KHUSUS untuk panggilan #1.
# Set ke 0 untuk mematikan pembatasan (baca semua halaman juga untuk
# field administratif).
EXTRACTION_MAX_PAGES=2

# --- Path database lokal ---
GLM_OCR_DB_PATH=/home/jiebon15/.local/share/glm-ocr-app/app.db

# --- Disiapkan untuk Tahap 4 (belum dipakai) ---
GOOGLE_APPLICATION_CREDENTIALS=/home/jiebon15/.config/glm-ocr-app/credentials.json
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=
